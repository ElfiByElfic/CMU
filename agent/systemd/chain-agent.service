[Unit]
Description=Chain agent – správa řetězců aplikací
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chainagent
Group=chainagent
ExecStart=/usr/local/bin/chain-agent --config /etc/chain-agent/agent.json
Restart=always
RestartSec=3
# Aplikace jsou potomci agenta (QProcess) a patří do jeho cgroup:
# zastavení nebo restart agenta zastaví i aplikace, agent je po startu
# znovu spustí podle chains.json (autostart). Pokud mají aplikace přežít
# restart agenta, použijte variantu se systemd šablonou (README, kap. 6).
KillMode=control-group
StateDirectory=chain-agent
LogsDirectory=chain-agent

[Install]
WantedBy=multi-user.target
