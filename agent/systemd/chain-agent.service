[Unit]
Description=Chain agent – správa řetězců aplikací
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chainagent
Group=chainagent
ExecStart=/opt/chain-agent/venv/bin/chain-agent --config /etc/chain-agent/agent.json
Restart=always
RestartSec=3
# Aplikace jsou potomci agenta a patří do jeho cgroup: zastavení agenta zastaví
# i aplikace a agent je po startu znovu spustí podle chains.json (autostart).
KillMode=control-group
TimeoutStopSec=45
StateDirectory=chain-agent
LogsDirectory=chain-agent

[Install]
WantedBy=multi-user.target
